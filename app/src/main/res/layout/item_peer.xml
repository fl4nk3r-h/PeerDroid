<?xml version="1.0" encoding="utf-8"?>
<!--
    item_peer.xml — Discovered peer row in Search Peers list
    ViewBinding IDs:
      binding.tvPeerIp       → "192.168.0.34:8989"
      binding.tvPeerLatency  → "12ms" (set GONE if not available)
      binding.btnConnect     → connect to this peer
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_container_high"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/md_theme_dark_outlineVariant"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PeerDroid.Small">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <View
            android:id="@+id/peerDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_dot_connected"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvPeerIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="192.168.0.34:8989"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/md_theme_dark_onSurface"
            android:fontFamily="@font/jetbrains_mono"
            app:layout_constraintStart_toEndOf="@id/peerDot"
            app:layout_constraintEnd_toStartOf="@id/tvPeerLatency"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0" />

        <TextView
            android:id="@+id/tvPeerLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="—"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/md_theme_dark_primary"
            android:fontFamily="@font/jetbrains_mono"
            app:layout_constraintEnd_toStartOf="@id/btnConnect"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            style="@style/Widget.PeerDroid.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Connect"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>